# Forge configuration.
# Copy to `.env` for local development (`npm run dev` / `npm start` load it if present).
# Never put real credentials in this file.

# Minimum log level: debug | info | warn | error (default: info)
FORGE_LOG_LEVEL=info

# Default timeout for external processes, in milliseconds: 1 to 86400000 (default: 120000)
FORGE_PROCESS_TIMEOUT_MS=120000

# Runtime mode: development | production | test (default: production)
FORGE_ENV=development
